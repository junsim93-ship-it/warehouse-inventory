rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.tier in [1, 2];
    }
    function tier2() {
      return approved() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.tier == 2;
    }
    match /roles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{collection}/{id} {
      allow read: if collection in ['shelves', 'pallets', 'stock', 'stockPrev', 'settings', 'boms'] && approved();
      // The callable validates and audits writes using the Admin SDK and IAM.
      allow write: if false;
    }
    match /auditLog/{id} { allow read: if tier2(); }
    match /auditVersions/{id}/data/{version} { allow read: if tier2(); }
  }
}
