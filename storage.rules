rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function lotSession(uid, authTime) {
      let role = firestore.get(/databases/(default)/documents/roles/$(uid)).data;
      return role.tier in [1, 2] && role.get('sessionValidAfter', 0) <= authTime;
    }
    function lotApproved() {
      return request.auth != null && request.auth.token.auth_time is int
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(8, 'h')
        && lotSession(request.auth.uid, request.auth.token.auth_time);
    }
    function lotValidKey(key) {
      return key.matches('[0-9]{2}(0[1-9]|1[012])V_[A-Z0-9-]+_[ABC]_(KR|N|M|C|NM|NC|MC|NMC)');
    }
    function lotSuffix(file, original, ext) {
      return file.matches('[a-f0-9-]{36}\\.' + ext) && original.lower().matches('.+\\.' + ext);
    }
    function lotFile(file) {
      let item = request.resource;
      let original = item.metadata.originalName;
      let mime = item.metadata.originalMime;
      return original is string && original.matches('[^/\\\\\\p{Cc}]+') && item.size > 0
        && item.metadata.cipher == 'aes-256-gcm-v1' && item.contentType == 'application/octet-stream'
        && ((item.metadata.kind == 'pdf' && mime == 'application/pdf'
              && lotSuffix(file, original, 'pdf') && item.size <= 100 * 1024 * 1024)
          || (item.metadata.kind == 'image' && item.size <= 30 * 1024 * 1024
            && ((mime == 'image/png' && lotSuffix(file, original, 'png'))
              || (mime == 'image/webp' && lotSuffix(file, original, 'webp'))
              || (mime == 'image/jpeg' && (lotSuffix(file, original, 'jpg') || lotSuffix(file, original, 'jpeg'))))));
    }
    match /lotDesigns/{designKey}/{file} {
      allow get, delete: if lotApproved() && lotValidKey(designKey);
      allow create: if resource == null && lotApproved() && lotValidKey(designKey) && lotFile(file);
    }
  }
}
